---
const { project, label = 'Images' } = Astro.props;
const g = project.data.gallery;
const tone = project.data.tone;
// Sans images fournies : 3 emplacements (2 côte à côte + 1 pleine largeur).
const items = g.length ? g : [
  { src: '', alt: '', wide: false, ph: 'Image 01' }, { src: '', alt: '', wide: false, ph: 'Image 02' }, { src: '', alt: '', wide: true, ph: 'Image 03 · full width' }];
// Regroupe : les « wide » seuls, les autres par paire.
const rows = []; let buf = [];
for (const it of items) { if (it.wide) { if (buf.length) rows.push(buf), buf = []; rows.push([it]); } else { buf.push(it); if (buf.length === 2) rows.push(buf), buf = []; } }
if (buf.length) rows.push(buf);
---
<h2 class="gl">{label}</h2>
<div class="rows">
  {rows.map(r => <div class:list={['row', {single: r.length === 1}]}>
    {r.map(it => <div class:list={['im', {wide: it.wide}]} style={`background:${tone}`}>
      {it.src ? <img src={it.src} alt={it.alt} loading="lazy" decoding="async" /> : <span class="ph">{it.ph}</span>}
    </div>)}
  </div>)}
</div>
<style>
  .gl{margin:96px 0 24px;font-size:15px;font-weight:500;color:var(--color-muted);letter-spacing:.02em}
  .rows{display:flex;flex-direction:column;gap:16px}
  .row{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px}
  .im{aspect-ratio:4/5;border-radius:var(--radius-card);position:relative;overflow:hidden}
  .im.wide{aspect-ratio:21/9}
  .im img{width:100%;height:100%;object-fit:cover}
  .ph{position:absolute;bottom:16px;right:16px;font-size:12px;padding:5px 10px;border-radius:999px;background:rgba(26,23,20,.55);color:var(--color-bg)}
  @media (max-width:720px){.gl{margin-top:56px}.im{border-radius:var(--radius-card-mobile)}.im.wide{aspect-ratio:3/2}}
</style>
