---
const { next } = Astro.props;
const n = next?.data;
---
<section aria-label="Next" class="next">
  {n && <a href={`/work/${n.slug}`} class="tile nx">
    <span class="lbl">Next project →</span>
    <div class="row">
      <div>
        <div class="nt">{n.title}</div>
        <div class="ns">{n.subtitle}</div>
      </div>
      <div class="mini" aria-hidden="true" style={`background:${n.tone}`}>{n.image && <img src={n.image} alt="" loading="lazy" />}</div>
    </div>
  </a>}
  <a href="/contact" class="tile touch">
    <svg width="72" height="72" viewBox="0 0 24 24" aria-hidden="true" style="position:absolute;top:24px;right:24px;transform:rotate(12deg)"><path d="M12 0c1 6 5 11 12 12-7 1-11 6-12 12-1-6-5-11-12-12 7-1 11-6 12-12z" fill="var(--color-blue)"/></svg>
    <span class="lbl" style="color:var(--color-ink)">Interested?</span>
    <span class="big">Get in touch →</span>
  </a>
</section>
<style>
  .next{margin-top:var(--section-space);display:flex;flex-wrap:wrap;gap:16px}
  .nx{flex:999 1 560px;min-width:0;min-height:300px;border-radius:var(--radius-card);background:var(--color-surface);padding:40px;display:flex;flex-direction:column;justify-content:space-between;gap:32px}
  .lbl{font-size:15px;font-weight:500;color:var(--color-muted)}
  .row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
  .nt{font-size:clamp(2.25rem,4.5vw,4rem);line-height:1;font-weight:600;letter-spacing:-.04em}
  .ns{font-size:15px;color:var(--color-muted);margin-top:8px}
  .mini{width:200px;height:130px;border-radius:var(--radius-poster);overflow:hidden}
  .mini img{width:100%;height:100%;object-fit:cover}
  .touch{flex:1 1 320px;min-height:300px;border-radius:var(--radius-card);background:var(--color-orange);padding:40px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}
  .big{font-size:36px;line-height:1;font-weight:600;letter-spacing:-.03em}
  @media (max-width:720px){.next{margin-top:var(--section-space-mobile)}.nx,.touch{padding:28px;border-radius:var(--radius-card-mobile);min-height:220px}.mini{display:none}}
</style>
