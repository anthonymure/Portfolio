---
import { localize } from '../i18n/project';
import { useT, type Lang } from '../i18n/ui';
const { project } = Astro.props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useT(lang);
const p = localize(project, lang);
---
<div class:list={['player', { vertical: p.vertical }]}>
  {p.youtube
    ? <iframe src={`https://www.youtube-nocookie.com/embed/${p.youtube}?rel=0&playsinline=1`} title={`${p.title} — ${t('proj.videoTitle')}`} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>
    : p.vimeo
    ? <iframe src={`https://player.vimeo.com/video/${p.vimeo}?dnt=1`} title={`${p.title} — ${t('proj.videoTitle')}`} allow="fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    : <>
        <div class="pc"><span class="pb" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#1A1714"/></svg></span></div>
        <span class="ph">{t('proj.videoSoon')}{p.duration ? ` · ${p.duration}` : ''}</span>
      </>}
  {!p.vertical && <span class="hand sound" aria-hidden="true">{t('proj.sound')}</span>}
</div>
<style>
  .player.vertical{aspect-ratio:9/16;width:min(100%,calc(80vh * 9 / 16));margin:0 auto}
  .player{aspect-ratio:16/9;border-radius:var(--radius-card);background:var(--color-dark);position:relative;overflow:hidden;color:var(--color-bg)}
  iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .pc{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .pb{width:104px;height:104px;border-radius:50%;background:var(--color-orange);display:flex;align-items:center;justify-content:center}
  .ph{position:absolute;left:28px;bottom:24px;font-size:14px;padding:6px 12px;border-radius:999px;background:rgba(243,238,228,.14)}
  .sound{position:absolute;top:28px;right:36px;font-size:32px;color:var(--color-orange);transform:rotate(5deg);pointer-events:none}
  @media (max-width:720px){.player{border-radius:var(--radius-card-mobile)}.pb{width:72px;height:72px}.sound{font-size:24px;top:16px;right:20px}}
</style>
