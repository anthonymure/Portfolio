---
import { localize, pick } from '../i18n/project';
import { useT, localePath, type Lang } from '../i18n/ui';
const { project, showYear = false } = Astro.props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useT(lang);
const p = localize(project, lang);
const isVideo = p.categories.includes('Video');
const href = localePath(lang, `/work/${p.slug}`);
---
<a href={href} class="tile card">
  <div class="thumb" style={`background:${p.tone}`}>
    {p.image && <img src={p.image.replace(/(-thumb)?\.webp$/, '-card.webp')} width="800" height="533" alt={pick(p.imageAlt, lang) || p.title} loading="lazy" decoding="async" />}
    <span class="cat">{p.categoryLabels.join(' · ')}</span>
    {p.sticker && <span class="hand sticker">{p.sticker}</span>}
    {isVideo && <span class="play" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#1A1714"/></svg></span>}
    {!p.image && <span class="ph" aria-hidden="true">{t('proj.imagePh')} · {p.title}</span>}
  </div>
  <div class="meta">
    <div>
      <div class="title">{p.title}</div>
      <div class="sub">{p.subtitle}</div>
    </div>
    {showYear && <span class="year">{p.year}</span>}
  </div>
</a>
<style>
  .card{color:var(--color-ink)}
  .thumb{aspect-ratio:3/2;border-radius:var(--radius-card);position:relative;overflow:hidden}
  .thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .cat{position:absolute;top:16px;left:16px;font-size:var(--text-label);font-weight:500;padding:6px 12px;border-radius:999px;background:rgba(243,238,228,.9)}
  .sticker{position:absolute;top:22px;right:22px;font-size:26px;padding:4px 16px;border-radius:999px;background:var(--color-blue);color:var(--color-bg);transform:rotate(8deg)}
  .play{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:50%;background:var(--color-orange);display:flex;align-items:center;justify-content:center}
  .sticker + .play{top:auto;bottom:16px;right:auto;left:16px}
  .ph{position:absolute;bottom:16px;right:16px;font-size:12px;padding:5px 10px;border-radius:999px;background:rgba(26,23,20,.55);color:var(--color-bg)}
  .meta{padding-top:16px;display:flex;justify-content:space-between;gap:16px;align-items:baseline}
  .title{font-size:20px;font-weight:600;letter-spacing:-.01em}
  .sub{font-size:var(--text-small);color:var(--color-muted);margin-top:4px}
  .year{font-size:14px;color:var(--color-muted);white-space:nowrap}
  @media (max-width:720px){.thumb{border-radius:var(--radius-card-mobile)}}
</style>
