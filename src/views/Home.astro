---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sparkle from '../components/Sparkle.astro';
import Star from '../components/Star.astro';
import Squiggle from '../components/Squiggle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useT, localePath, categoryLabels, type Lang } from '../i18n/ui';
import { localize } from '../i18n/project';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useT(lang);
const L = (p: string) => localePath(lang, p);
const featured = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,4);
const what = (['Photography','Video','Graphic design'] as const).map((c) => [categoryLabels[c][lang], c.toLowerCase().replace(' ','-')]);
---
<Base title="Anthony Mure" description={t('meta.home.desc')}>
  <section class="hero">
    <h1>Anthony<br><span class="mure">Mure<svg viewBox="0 0 220 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16c40-12 92-14 150-7 28 3 44 7 62 1" fill="none" stroke="var(--color-blue)" stroke-width="7" stroke-linecap="round"/></svg></span><span class="dot">.</span>
      <Sparkle size={64} color="var(--color-orange)" style="position:absolute;top:-18px;right:-72px" />
      <Sparkle size={28} color="var(--color-blue)" style="position:absolute;top:46px;right:-96px" />
    </h1>
    <div class="side">
      <div class="badge">
        <svg width="136" height="136" viewBox="0 0 100 100" aria-hidden="true"><polygon points="100.0,50.0 90.9,59.3 95.0,71.7 82.8,76.2 81.2,89.1 68.2,87.8 61.1,98.7 50.0,92.0 38.9,98.7 31.8,87.8 18.8,89.1 17.2,76.2 5.0,71.7 9.1,59.3 0.0,50.0 9.1,40.7 5.0,28.3 17.2,23.8 18.8,10.9 31.8,12.2 38.9,1.3 50.0,8.0 61.1,1.3 68.2,12.2 81.2,10.9 82.8,23.8 95.0,28.3 90.9,40.7" fill="var(--color-blue)"/></svg>
        <span class="hand" set:html={t('home.badge')} />
      </div>
      <p>{t('home.tagline')}</p>
    </div>
  </section>

  <section aria-label="Showreel and quick links" class="bento">
    <div class="tile reel" id="reel" data-yt="ZVvlu6oplPk" data-title="LOIRE CINEMATIC — Château de Sail-sous-Couzan">
      <img class="reelimg" src="/images/home/showreel.webp" alt="" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
      <button type="button" class="reelbtn" aria-label={t('home.showreelAria')}></button>
      <div class="playwrap"><div class="playbtn"><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="#1A1714"/></svg></div></div>
      <div class="press"><span class="hand">{t('home.press')}</span><svg width="64" height="48" viewBox="0 0 64 48" aria-hidden="true"><path d="M4 8c22-2 42 8 50 30M42 34l12 6 3-13" fill="none" stroke="var(--color-orange)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <svg class="wave" width="150" height="60" viewBox="0 0 150 60" aria-hidden="true"><path d="M6 40c14-26 22-26 26 0s14 26 26 0 16-26 26 0 14 26 26 0 12-20 34-14" fill="none" stroke="#F3EEE4" stroke-opacity=".35" stroke-width="4" stroke-linecap="round"/></svg>
      <div class="reelfoot"><span>{t('home.showreel')}</span></div>
    </div>
    <div class="col">
      <div class="orange">
        <span class="lab">{t('home.whatIDo')}</span>
        <Sparkle size={44} color="var(--color-blue)" style="position:absolute;top:22px;right:24px;transform:rotate(12deg)" />
        <div class="links">
          {what.map(([l,f]) => <a href={L(`/work?filter=${f}`)}>{l} <span aria-hidden="true">→</span></a>)}
        </div>
      </div>
      <div class="blue">
        <Star size={120} color="var(--color-orange)" style="position:absolute;top:-18px;right:-14px;transform:rotate(14deg)" />
        <span class="avail"><span class="dotg" aria-hidden="true"></span>{t('home.available')}</span>
        <div>
          <a href={L('/contact')} class="big">{t('home.getInTouch')}</a>
          <p>mure.anthony@gmail.com</p>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="sel" class="selected">
    <div class="sh">
      <h2 id="sel">{t('home.selected')} <Squiggle /></h2>
      <a href={L('/work')} class="all">{t('home.viewAll')}</a>
    </div>
    <div class="grid">
      {featured.map(p => <ProjectCard project={p} />)}
    </div>
  </section>

  <section aria-labelledby="cta" class="cta" style="background:var(--color-blue);color:var(--color-bg)">
    <Sparkle size={90} color="var(--color-orange)" style="position:absolute;top:28px;right:56px;transform:rotate(10deg)" />
    <Sparkle size={34} color="var(--color-bg)" style="position:absolute;top:120px;right:30px" />
    <h2 id="cta">{t('home.ctaTitle')} <span style="color:var(--color-orange)">{t('home.ctaAccent')}</span></h2>
    <a href={L('/contact')} class="pill-btn" style="background:var(--color-orange);color:var(--color-ink)">{t('home.ctaBtn')} <span aria-hidden="true">→</span></a>
  </section>
</Base>
<style>
  .hero{display:flex;flex-wrap:wrap;gap:24px 48px;justify-content:space-between;align-items:flex-end;padding:56px 0 40px}
  h1{margin:0;font-size:var(--text-hero);line-height:var(--leading-tight);font-weight:600;letter-spacing:var(--tracking-tight);position:relative}
  .mure{position:relative;display:inline-block}
  .mure svg{position:absolute;left:-2%;bottom:-.16em;width:104%;height:.24em}
  .dot{color:var(--color-orange)}
  .side{display:flex;flex-direction:column;align-items:flex-end;gap:24px}
  .badge{width:136px;height:136px;position:relative;transform:rotate(-10deg)}
  .badge svg{position:absolute;inset:0}
  .badge span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:24px;line-height:.95;color:var(--color-bg)}
  .side p{margin:0;max-width:340px;font-size:17px;line-height:1.5;color:var(--color-muted)}
  .bento{display:flex;flex-wrap:wrap;gap:var(--gap-bento)}
  .reel{flex:999 1 560px;min-width:0;height:560px;border-radius:var(--radius-card);background:var(--color-dark);position:relative;overflow:hidden;color:var(--color-bg)}
  .reelimg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.85}
  .reelbtn{position:absolute;inset:0;width:100%;height:100%;border:0;background:transparent;cursor:pointer;z-index:2}
  .reelbtn:focus-visible{outline:3px solid var(--color-orange);outline-offset:-6px}
  .reel :global(iframe){position:absolute;inset:0;width:100%;height:100%;border:0;z-index:3}
  .playwrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .playbtn{width:88px;height:88px;border-radius:50%;background:var(--color-orange);display:flex;align-items:center;justify-content:center}
  .press{position:absolute;top:32px;left:36px;display:flex;align-items:flex-end;gap:4px;transform:rotate(-6deg)}
  .press .hand{font-size:36px;color:var(--color-orange)}
  .wave{position:absolute;right:28px;top:28px}
  .reelfoot{position:absolute;left:24px;bottom:24px;font-size:15px;font-weight:500}
  .col{flex:1 1 320px;display:flex;flex-direction:column;gap:var(--gap-bento)}
  .orange,.blue{flex:1;min-height:272px;border-radius:var(--radius-card);position:relative;overflow:hidden;padding:28px;display:flex;flex-direction:column;justify-content:space-between}
  .orange{background:var(--color-orange)}
  .lab{font-size:14px;font-weight:500}
  .links{display:flex;flex-direction:column;gap:6px;font-size:30px;font-weight:600;letter-spacing:-.02em}
  .links a{display:flex;justify-content:space-between;align-items:center;min-height:var(--tap-min)}
  .orange a:hover{color:var(--color-bg)}
  .blue{background:var(--color-blue);color:var(--color-bg)}
  .avail{position:relative;font-size:14px;color:var(--color-on-blue-muted);display:flex;align-items:center;gap:8px}
  .dotg{width:8px;height:8px;border-radius:50%;background:var(--color-orange)}
  .big{color:var(--color-bg);font-size:30px;font-weight:600;letter-spacing:-.02em;position:relative}
  .big:hover{color:var(--color-orange)}
  .blue p{margin:8px 0 0;font-size:15px;color:var(--color-on-blue-muted)}
  .selected{padding-top:var(--section-space)}
  .sh{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:32px}
  h2#sel{margin:0;font-size:var(--text-h2);font-weight:600;letter-spacing:-.03em;display:flex;align-items:center;gap:14px}
  .all{font-size:var(--text-small);font-weight:500;color:var(--color-muted)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,480px),1fr));gap:48px 16px}
  @media (max-width:720px){
    .hero{padding:32px 0 28px}.side{align-items:flex-start}
    h1 :global(svg:not(.mure svg)){display:none}
    .reel{height:380px;flex-basis:100%;border-radius:var(--radius-card-mobile)}
    .orange,.blue{border-radius:var(--radius-card-mobile)}
    .selected{padding-top:var(--section-space-mobile)}
    .wave{display:none}
  }
</style>
<script>
  const reel = document.getElementById('reel');
  reel?.querySelector('.reelbtn')?.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${reel.dataset.yt}?autoplay=1&rel=0`;
    f.title = reel.dataset.title ?? '';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    reel.append(f);
    f.focus();
  });
</script>
