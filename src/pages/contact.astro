---
import Base from '../layouts/Base.astro';
import Sparkle from '../components/Sparkle.astro';
const types = [['Photography', 'photography'], ['Video', 'video'], ['Content creation', 'content-creation'], ['Something else', 'other']];
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---
<Base title="Contact" description="Get in touch with Anthony Mure for photography, video or content creation projects in Saint-Étienne." current="/contact">
  <div class="wrap">
    <section class="blue">
      <Sparkle size={120} color="var(--color-orange)" style="position:absolute;bottom:-20px;right:-16px;transform:rotate(14deg)" />
      <div>
        <h1>Let’s<br>talk<span>.</span></h1>
        <p>A shoot, a film, a monthly content plan? Tell me about it.</p>
      </div>
      <div class="links">
        <a href="mailto:mure.anthony@gmail.com" class="mail">mure.anthony@gmail.com</a>
        <div class="soc">
          <!-- Liens à confirmer avec Anthony -->
          <a href="https://instagram.com/honoo_agency">Instagram ↗</a>
          <a href="https://youtube.com/@B.Berry3">YouTube ↗</a>
          <a href="https://linkedin.com/in/anthony-mure-3044a9130">LinkedIn ↗</a>
        </div>
      </div>
    </section>

    <section aria-label="Contact form" class="formsec">
      <div id="done" hidden role="status" class="done">
        <span class="hand">message received!</span>
        <p>Thanks — I’ll get back to you within [DELAY].</p>
        <button type="button" id="again" class="again">Send another message</button>
      </div>
      <form id="form" novalidate data-endpoint={endpoint}>
        <div class="two">
          <label>Name<input class="field" type="text" name="name" placeholder="Your name" autocomplete="name" required /><span class="err" data-for="name"></span></label>
          <label>Email<input class="field" type="email" name="email" placeholder="you@example.com" autocomplete="email" required /><span class="err" data-for="email"></span></label>
        </div>
        <label>Project type
          <select class="field" name="type" id="type">{types.map(([l, v]) => <option value={v}>{l}</option>)}</select>
        </label>
        <label>Message<textarea class="field" name="message" rows="7" placeholder="What, when, where — anything that helps." required></textarea><span class="err" data-for="message"></span></label>
        <div class="row">
          <span class="hand">no long brief needed ✓</span>
          <button class="send" type="submit">Send message →</button>
        </div>
        <p id="fallback" class="fb" hidden>Your email app should open with the message ready to send. If nothing happens, write to mure.anthony@gmail.com.</p>
      </form>
    </section>
  </div>
</Base>
<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const done = document.getElementById('done')!, fb = document.getElementById('fallback')!;
  const sel = document.getElementById('type') as HTMLSelectElement;
  const t = new URLSearchParams(location.search).get('type');
  if (t && [...sel.options].some((o) => o.value === t)) sel.value = t;

  function validate() {
    let ok = true, first: HTMLElement | null = null;
    for (const n of ['name', 'email', 'message']) {
      const el = form.elements.namedItem(n) as HTMLInputElement;
      const err = form.querySelector<HTMLElement>(`[data-for=${n}]`)!;
      let m = '';
      if (!el.value.trim()) m = 'Required.';
      else if (n === 'email' && !/^\S+@\S+\.\S+$/.test(el.value)) m = 'Enter a valid email address.';
      err.textContent = m; el.setAttribute('aria-invalid', String(!!m));
      if (m) { ok = false; first ??= el; }
    }
    first?.focus();
    return ok;
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;
    const data = new FormData(form);
    const endpoint = form.dataset.endpoint;
    if (endpoint) {
      try {
        const r = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error();
      } catch { fb.textContent = 'Something went wrong. Please email mure.anthony@gmail.com directly.'; fb.hidden = false; return; }
      form.hidden = true; done.hidden = false; (done.querySelector('button') as HTMLElement).focus();
    } else {
      // Pas de service de formulaire configuré : repli sur le client mail.
      const body = `${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})`;
      location.href = `mailto:mure.anthony@gmail.com?subject=${encodeURIComponent('Project: ' + sel.selectedOptions[0].text)}&body=${encodeURIComponent(body)}`;
      fb.hidden = false;
    }
  });
  document.getElementById('again')!.addEventListener('click', () => { form.reset(); form.hidden = false; done.hidden = true; fb.hidden = true; });
</script>
<style>
  .wrap{padding-top:32px;display:flex;flex-wrap:wrap;gap:16px}
  .blue{flex:1 1 420px;border-radius:var(--radius-card);background:var(--color-blue);color:var(--color-bg);padding:48px;display:flex;flex-direction:column;justify-content:space-between;gap:48px;position:relative;overflow:hidden;min-height:640px}
  h1{margin:0;font-size:clamp(3.5rem,7vw,6.5rem);line-height:.92;font-weight:600;letter-spacing:var(--tracking-tight)}
  h1 span{color:var(--color-orange)}
  .blue p{margin:24px 0 0;max-width:360px;font-size:17px;line-height:1.55;color:var(--color-on-blue-muted)}
  .links{display:flex;flex-direction:column;gap:20px;position:relative}
  .mail{color:var(--color-bg);font-size:26px;font-weight:600;letter-spacing:-.02em}
  .mail:hover{color:var(--color-orange)}
  .soc{display:flex;gap:10px;flex-wrap:wrap}
  .soc a{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;background:rgba(243,238,228,.14);color:var(--color-bg);font-size:15px;font-weight:500}
  .soc a:hover{background:var(--color-bg);color:var(--color-blue)}
  .formsec{flex:999 1 560px;min-width:0;border-radius:var(--radius-card);background:var(--color-surface);padding:48px}
  form{display:flex;flex-direction:column;gap:20px}
  form[hidden]{display:none}
  .two{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px}
  label{display:flex;flex-direction:column;gap:8px;font-size:14px;font-weight:500;color:var(--color-text)}
  .field{font:inherit;font-size:16px;color:var(--color-ink);background:var(--color-bg);border:2px solid transparent;border-radius:16px;padding:14px 16px;min-height:var(--tap-min);width:100%}
  textarea.field{resize:vertical}
  .field[aria-invalid=true]{border-color:var(--color-orange-text)}
  .err{font-size:13px;color:var(--color-orange-text);min-height:0}
  .row{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-top:8px}
  .row .hand{font-size:24px;color:var(--color-blue)}
  .send{font:inherit;cursor:pointer;border:0;min-height:56px;padding:0 32px;border-radius:999px;background:var(--color-orange);color:var(--color-ink);font-size:16px;font-weight:600}
  .send:hover{background:var(--color-ink);color:var(--color-bg)}
  .fb{margin:0;font-size:14px;color:var(--color-text)}
  .done{min-height:540px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:16px}
  .done[hidden]{display:none}
  .done .hand{font-size:44px;color:var(--color-blue);transform:rotate(-3deg)}
  .done p{margin:0;font-size:18px;color:var(--color-text)}
  .again{font:inherit;cursor:pointer;border:0;min-height:48px;padding:0 22px;border-radius:999px;background:var(--color-bg);font-size:15px;font-weight:500}
  @media (max-width:720px){.blue,.formsec{padding:28px;border-radius:var(--radius-card-mobile)}.blue{min-height:0}.mail{font-size:21px}}
</style>
