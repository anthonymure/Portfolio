---
import Base from '../layouts/Base.astro';
import Sparkle from '../components/Sparkle.astro';
const services = [
  { n: '01', title: 'Photography', type: 'photography', theme: 'surface', thumb: '#C9B79F', text: 'Product, portrait and event photography. Natural light or simple setups, edited in a consistent style.', gets: ['Edited high-resolution photos', 'Web and social media formats', 'Online gallery to download'], price: 'From [PRICE]' },
  { n: '02', title: 'Video', type: 'video', theme: 'orange', thumb: '#2E2924', sticker: 'action!', text: 'Reels, product films and event teasers. From idea to final edit, made for the screen it will be watched on.', gets: ['Edited video with music and color grading', 'Vertical and horizontal versions', 'Short cut-downs for social media'], price: 'From [PRICE]' },
  { n: '03', title: 'Content creation', type: 'content-creation', theme: 'blue', thumb: '#E9C3A2', text: 'Regular photo and video content for your social media, planned around your news and events.', gets: ['A content plan for the month', 'Photos and reels ready to post', 'Formats for each platform'], price: 'On request' },
];
---
<Base title="Services" description="Photography, video and content creation services by Anthony Mure in Saint-Étienne, France." current="/services">
  <section class="head">
    <h1>Services<Sparkle size={56} color="var(--color-orange)" style="position:absolute;top:-20px;right:-64px" /></h1>
    <p>Three ways to work together, for brands, venues and events that want images people stop scrolling for.</p>
  </section>
  <div class="cards">
    {services.map((s) => (
      <article class={`card ${s.theme}`}>
        {s.sticker && <span class="hand sticker">{s.sticker}</span>}
        <div class="top"><span class="num">{s.n}</span><div class="thumb" aria-hidden="true" style={`background:${s.thumb}`}></div></div>
        <h2>{s.title}</h2>
        <p>{s.text}</p>
        <div>
          <div class="gl">What you get</div>
          <ul>{s.gets.map((g) => <li>{g}</li>)}</ul>
        </div>
        <div class="foot">
          <span class="price">{s.price}</span>
          <a href={`/contact?type=${s.type}`} class="btn">Get in touch →</a>
        </div>
      </article>
    ))}
  </div>
  <section aria-labelledby="cta" class="notsure">
    <h2 id="cta">Not sure what you need? <span class="hand">let’s figure it out</span></h2>
    <a href="/contact" class="pill-btn" style="background:var(--color-orange);color:var(--color-ink)">Get in touch →</a>
  </section>
</Base>
<style>
  .head{padding:56px 0;display:flex;flex-wrap:wrap;gap:24px 64px;justify-content:space-between;align-items:flex-end}
  h1{margin:0;font-size:var(--text-page-title);line-height:var(--leading-tight);font-weight:600;letter-spacing:var(--tracking-tight);position:relative}
  .head p{margin:0;max-width:380px;font-size:17px;line-height:1.55;color:var(--color-text)}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:16px}
  .card{border-radius:var(--radius-card);padding:36px;display:flex;flex-direction:column;gap:28px;min-height:620px;position:relative}
  .surface{background:var(--color-surface);color:var(--color-text)}
  .orange{background:var(--color-orange);color:var(--color-ink)}
  .blue{background:var(--color-blue);color:var(--color-on-blue-muted)}
  .surface h2,.surface .price,.surface .gl{color:var(--color-ink)}
  .blue h2,.blue .price,.blue .gl{color:var(--color-bg)}
  .top{display:flex;justify-content:space-between;align-items:center}
  .num{font-size:15px;font-weight:500}
  .surface .num{color:var(--color-muted)}
  .thumb{width:112px;height:76px;border-radius:16px}
  h2{margin:0;font-size:var(--text-h2);font-weight:600;letter-spacing:-.03em}
  .card p{margin:0;font-size:16px;line-height:1.55}
  .gl{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px}
  ul{margin:0;padding-left:18px;font-size:15px;line-height:1.8}
  .foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
  .price{font-size:16px;font-weight:600}
  .btn{display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border-radius:999px;background:var(--color-ink);color:var(--color-bg);font-size:15px;font-weight:500}
  .btn:hover{color:var(--color-bg);background:var(--color-blue)}
  .blue .btn{background:var(--color-orange);color:var(--color-ink)}
  .blue .btn:hover{color:var(--color-ink);background:var(--color-bg)}
  .sticker{position:absolute;top:-18px;right:28px;font-size:26px;padding:2px 16px;border-radius:999px;background:var(--color-blue);color:var(--color-bg);transform:rotate(6deg)}
  .notsure{margin-top:var(--section-space);display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center;padding:40px 0;border-top:1px solid var(--color-line)}
  .notsure h2{font-size:32px}
  .notsure .hand{color:var(--color-blue);font-size:38px}
  @media (max-width:720px){.head{padding:32px 0}.card{padding:28px;border-radius:var(--radius-card-mobile);min-height:0}.notsure{margin-top:var(--section-space-mobile)}.notsure h2{font-size:26px}h1 :global(svg){display:none}}
</style>
