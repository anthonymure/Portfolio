---
import Base from '../layouts/Base.astro';
const clients = ['[Bar name]', ...Array(7).fill('[Client logo]')];
---
<Base title="About" description="Anthony Mure is a photographer, videographer and content creator based in Saint-Étienne, France." current="/about">
  <section class="top">
    <div class="portrait">
      <div class="arch" aria-hidden="true"></div>
      <span class="ph">Photo · portrait of Anthony</span>
      <span class="hand st">that’s me!</span>
    </div>
    <div class="bio">
      <h1>Hi, I’m <span class="a">Anthony<svg viewBox="0 0 220 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16c40-12 92-14 150-7 28 3 44 7 62 1" fill="none" stroke="var(--color-blue)" stroke-width="7" stroke-linecap="round"/></svg></span>.</h1>
      <div class="txt">
        <p>I’m a photographer, videographer and content creator based in Saint-Étienne, France.</p>
        <!-- Texte à compléter par Anthony -->
        <p>I make images for brands, bars and events: photos, short films, reels and posters. [One or two more sentences about how you work.]</p>
      </div>
      <div class="btns">
        <a href="/contact" class="b dark">Get in touch →</a>
        <a href="/work" class="b light">See my work</a>
      </div>
    </div>
  </section>
  <section aria-labelledby="clients" class="clients">
    <div class="ch">
      <h2 id="clients">They trusted me <svg width="64" height="20" viewBox="0 0 64 20" aria-hidden="true"><path d="M3 13c6-10 10-10 13 0s7 10 13 0 8-10 13 0 7 9 19-2" fill="none" stroke="var(--color-orange)" stroke-width="4" stroke-linecap="round"/></svg></h2>
      <span class="hand">and more to come</span>
    </div>
    <ul class="grid">{clients.map((c) => <li>{c}</li>)}</ul>
  </section>
</Base>
<style>
  .top{display:flex;flex-wrap:wrap;gap:16px;padding-top:32px}
  .portrait{flex:1 1 380px;min-height:640px;border-radius:var(--radius-card);background:var(--color-orange);position:relative;overflow:hidden}
  .arch{position:absolute;left:40px;right:40px;top:48px;bottom:0;border-radius:200px 200px 0 0;background:#C9B79F}
  .ph{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);font-size:12px;padding:5px 10px;border-radius:999px;background:rgba(26,23,20,.55);color:var(--color-bg);white-space:nowrap}
  .st{position:absolute;top:28px;right:28px;font-size:30px;padding:2px 16px;border-radius:999px;background:var(--color-blue);color:var(--color-bg);transform:rotate(8deg)}
  .bio{flex:999 1 560px;min-width:0;border-radius:var(--radius-card);background:var(--color-surface);padding:48px;display:flex;flex-direction:column;justify-content:space-between;gap:40px}
  h1{margin:0;font-size:clamp(3rem,6vw,6rem);line-height:.95;font-weight:600;letter-spacing:var(--tracking-tight)}
  .a{position:relative;display:inline-block}
  .a svg{position:absolute;left:-2%;bottom:-.14em;width:104%;height:.22em}
  .txt{display:flex;flex-direction:column;gap:16px;max-width:620px;font-size:19px;line-height:1.55;color:var(--color-text)}
  .txt p{margin:0}
  .btns{display:flex;flex-wrap:wrap;gap:12px}
  .b{display:inline-flex;align-items:center;min-height:52px;padding:0 24px;border-radius:999px;font-size:15px;font-weight:500}
  .dark{background:var(--color-ink);color:var(--color-bg)}.dark:hover{background:var(--color-blue);color:var(--color-bg)}
  .light{background:var(--color-bg)}
  .clients{padding-top:var(--section-space)}
  .ch{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:32px}
  h2{margin:0;font-size:var(--text-h2);font-weight:600;letter-spacing:-.03em;display:flex;align-items:center;gap:14px}
  .ch .hand{font-size:26px;color:var(--color-blue);transform:rotate(-3deg)}
  .grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));gap:16px}
  .grid li{height:140px;border-radius:24px;background:var(--color-surface);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:600;color:var(--color-muted)}
  @media (max-width:720px){.portrait{min-height:460px;border-radius:var(--radius-card-mobile)}.bio{padding:28px;border-radius:var(--radius-card-mobile)}.clients{padding-top:var(--section-space-mobile)}.txt{font-size:17px}}
</style>
